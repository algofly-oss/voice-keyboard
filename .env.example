# Copy to .env (./setup.sh does it). Compose settings; app settings live in
# backend/.env. HTTPS scenarios (LAN, domain, tunnel, port forward): docs/https.md

# Where Whisper runs. gpu: NVIDIA GPU (default)   cpu: CPU only, no NVIDIA GPU needed
COMPOSE_PROFILES=gpu

# HTTPS (always on). EVERY name or IP clients use to reach the server,
# comma-separated, including names used through tunnels and port forwards.
VK_DOMAIN=localhost
# Certificate for clients that connect by IP address (they send no name).
VK_DEFAULT_SNI=localhost
# "internal": local CA, trusted once per device (https://<server>/ca.crt).
# An email address: Let's Encrypt, for a public VK_DOMAIN.
VK_TLS=internal
# The only port: HTTPS (plain HTTP to it is redirected).
HTTPS_PORT=443

