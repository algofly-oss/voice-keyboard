# Voice Keyboard settings: the only settings file. Copy to .env (./setup.sh does
# it and fills in the values marked "setup.sh"). HTTPS scenarios (LAN, domain,
# tunnel, port forward): docs/https.md

# --- Deployment
# Where Whisper runs. gpu: NVIDIA GPU (default)   cpu: CPU only, no NVIDIA GPU needed
COMPOSE_PROFILES=gpu

# --- Accounts
# The first (admin) account is created from these when the database is empty.
# Afterwards passwords are changed in Settings → Account; the database value then
# wins and WEB_PASSWORD is not read again.
ADMIN_USERNAME=admin
# setup.sh generates random values for these two.
WEB_PASSWORD=change-me-too
# Signs login sessions; keep it stable so sessions survive restarts.
SESSION_SECRET=generate-a-long-random-value
# Let people create their own accounts on the login page.
ALLOW_SIGNUPS=false
# Optional key for scripts (Authorization: Bearer …); acts as the admin account.
# The web UI never needs it.
# API_KEY=change-me

# --- Whisper
# transcribe: types what you say, in the language you say it (large-v3-turbo).
# translate:  speak Hindi, Bengali, Telugu or any other language and it types the
#             English translation (large-v3; ~1 GB more GPU memory, ~3 GB download).
WHISPER_VARIANT=transcribe
# Language the web UI starts with (users can pick any of Whisper's 100 languages
# in Settings, or detection). An ISO code such as en, hi, es; empty = detect.
WHISPER_LANGUAGE=en
# Optional: override the model chosen by WHISPER_VARIANT.
# WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# int8_float16 (GPU default) or int8 (CPU default); float16 is marginally more accurate.
# WHISPER_COMPUTE_TYPE=int8_float16
# One Whisper model serves every account; requests beyond this many wait in line.
WHISPER_CONCURRENCY=1
# Beam search width. 5 (default) is the most accurate; 1 (greedy) was only ~6%
# faster on an RTX 3060 and noticeably worse at translation.
# WHISPER_BEAM_SIZE=5

# --- HTTPS and ports (docs/https.md)
# https (default): serve the app over HTTPS with automatic certificates.
# http: plain HTTP only, behind a tunnel/proxy that adds HTTPS (e.g. Cloudflare).
# both: HTTPS on HTTPS_PORT and plain HTTP (no redirect) on HTTP_PORT, e.g. HTTPS
#       on the LAN plus plain HTTP for a Cloudflare tunnel.
VK_PROTOCOL=https
# EVERY name or IP clients use to reach the server, comma-separated, including
# names used through tunnels and port forwards.   setup.sh: this machine's IP and name
VK_DOMAIN=localhost
# Certificate for clients that connect by IP address (they send no name).
VK_DEFAULT_SNI=localhost
# "internal": local CA, trusted once per device (https://<server>/ca.crt).
# An email address: Let's Encrypt, for a public VK_DOMAIN.
VK_TLS=internal
# HTTPS_PORT serves the app (https mode). HTTP_PORT redirects to it and serves
# /ca.crt; in http/both mode it serves the app. setup.sh: free ports.
HTTPS_PORT=443
HTTP_PORT=80
# Set to 127.0.0.1 to keep a port off the network.
# HTTPS_BIND=0.0.0.0
# HTTP_BIND=0.0.0.0

# --- Desktop client downloads
# The server mirrors the newest v* GitHub release and serves the binaries at
# /client. A private repository needs a token that can read its contents.
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=github_pat_...
# RELEASE_SYNC_SECONDS=3600
