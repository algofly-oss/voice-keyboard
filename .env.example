# Copy to .env. Compose settings (app settings live in backend/.env).

# Where Whisper runs. gpu: NVIDIA GPU (default)   cpu: CPU only, no NVIDIA GPU needed
COMPOSE_PROFILES=gpu

# HTTPS (always on). Names this server is reached by, comma-separated.
VK_DOMAIN=localhost
# Certificate for clients that connect by IP address (they send no name).
VK_DEFAULT_SNI=localhost
# "internal": local CA, trusted once per device (http://<server>/ca.crt).
# An email address: Let's Encrypt, for a public VK_DOMAIN.
VK_TLS=internal
HTTPS_PORT=443
HTTP_PORT=80

# The gateway's plain-HTTP port is published on 127.0.0.1 only.
# Set API_BIND=0.0.0.0 if something else must reach it over HTTP.
# API_BIND=127.0.0.1
# API_PORT=8271
