# HTTPS in front of the gateway, started by `docker compose up`. There is no
# plain-HTTP port: HTTP requests arriving on the HTTPS port are redirected.
#   VK_DOMAIN       names this server is reached by, comma-separated
#                   (e.g. "voice.example.com" or "192.168.1.20, localhost")
#   VK_DEFAULT_SNI  name whose certificate is used when a client sends none
#                   (connections by IP address); defaults to localhost
#   VK_TLS          "internal" (default): certificates from Caddy's own local CA,
#                   trusted once per device (/ca.crt, /client/trust-ca.*).
#                   An email address: Let's Encrypt for a public domain
#                   (needs HTTPS_PORT=443 reachable from the internet).
{
	skip_install_trust
	auto_https disable_redirects
	default_sni {$VK_DEFAULT_SNI:localhost}
	servers {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

{$VK_DOMAIN:localhost} {
	tls {$VK_TLS:internal}
	encode gzip
	# The local CA's root certificate, for devices to trust.
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=\"vkeyboard-ca.crt\""
		file_server
	}
	handle {
		reverse_proxy gateway:8000
	}
}
