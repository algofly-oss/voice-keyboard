# Copy to backend/.env and adjust.

# --- Accounts
# The first (admin) account is created from these when the database is empty.
# Afterwards the admin changes the password in Settings → Account; the database
# value then wins and WEB_PASSWORD is not read again.
ADMIN_USERNAME=admin
WEB_PASSWORD=change-me-too
# Let people create their own accounts on the login page.
ALLOW_SIGNUPS=false
# Signs login sessions; keep it stable so sessions survive restarts.
SESSION_SECRET=generate-a-long-random-value
# Optional key for scripts (Authorization: Bearer …); acts as the admin account.
# API_KEY=change-me

# --- Server
# Host port for the web UI and API.
API_PORT=8271
# Private Whisper port inside the container. It is not published on the host.
TRANSCRIPTION_PORT=8001
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# int8_float16 uses less VRAM; float16 is marginally more accurate.
WHISPER_COMPUTE_TYPE=int8_float16
# One Whisper model serves every account; requests beyond this many wait in line.
WHISPER_CONCURRENCY=1

# --- Desktop client downloads
# The gateway mirrors the newest v* GitHub release into /data/releases and
# serves the binaries at /client. A private repository needs a token that can
# read its contents.
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=github_pat_...
# RELEASE_SYNC_SECONDS=3600
