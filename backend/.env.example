# Copy to .env and adjust. All values are optional.
# Host port for the FastAPI gateway and web UI.
API_PORT=8271
# Private Whisper port inside the container. It is not published on the host.
TRANSCRIPTION_PORT=8001
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# int8_float16 uses less VRAM; float16 is marginally more accurate.
WHISPER_COMPUTE_TYPE=int8_float16
# Uncomment to require a key; enter the same value in the web app settings.
# API_KEY=change-me
# Password for the backend web login.
# WEB_PASSWORD=change-me-too
# Stable secret used to keep login sessions valid across container redeploys.
# SESSION_SECRET=generate-a-long-random-value
# Optional public origin used in generated WebSocket and installer URLs.
# PUBLIC_BASE_URL=https://voice-keyboard.example
# Mobile builds: the gateway mirrors the newest voice-keyboard-v* GitHub release
# (VoiceKeyboard.apk / VoiceKeyboard.ipa) into /data/releases and serves them at
# /downloads. A private repository needs a token with read access to contents.
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=github_pat_...
# RELEASE_SYNC_SECONDS=3600
# Optional TestFlight or App Store link shown on /downloads.
# IOS_DOWNLOAD_URL=https://testflight.apple.com/join/your-code
