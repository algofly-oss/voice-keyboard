# Copy to esp32/.env. This file is ignored by Git.
VK_DEFAULT_WIFI_NAME=your-wifi-name
VK_DEFAULT_WIFI_PASSWORD=your-wifi-password
VK_DEFAULT_SERVER_URL=https://your-backend.example
VK_DEFAULT_API_KEY=change-me
# Password for the ESP32 web app (changeable later in Settings → Device).
VK_DEFAULT_WEB_PASSWORD=change-me
